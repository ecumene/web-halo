# Address and ports the two services listen on: 127.0.0.1 when the reverse
# proxy runs on this machine, 0.0.0.0 when it runs elsewhere.
HALO_BIND=127.0.0.1
HALO_WEB_PORT=8765
HALO_SIGNALING_PORT=8787

# Public address of the game, given by the reverse proxy (e.g.
# https://halo.example.lan). Empty: the game is used at
# http://127.0.0.1:8765 on this machine only.
HALO_PUBLIC_ORIGIN=
