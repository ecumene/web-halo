# Settings for the Dockge stack. Paste into the stack's .env box (or save as
# .env next to compose.yaml) and fill in the two marked values.

# 1. Where Docker gets the source: your fork's selfhost branch.
HALO_SOURCE=https://github.com/YOUR-GITHUB-USER/web-halo.git#selfhost

# 2. This server's LAN IP: the address players type, and the address on the
#    HTTPS certificate. Give the server a DHCP reservation so it doesn't change.
HALO_HOST=192.168.1.50

# Host port for HTTPS. 443 gives URLs without a port, if nothing else uses it.
HALO_HTTPS_PORT=8443

# Disc image file name inside ./iso (only used by the one-time extract step).
HALO_ISO=halo.iso

# Browser origins allowed to use the room service. "*" is fine on a LAN.
ALLOWED_ORIGINS=*

# Parallel compile jobs for the build (0 = all cores).
BUILD_JOBS=0
